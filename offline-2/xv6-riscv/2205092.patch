+uint64
+sys_trace(void)
+{
+  int n;
+  argint(0, &n);
+  myproc()->e_traceSysCall = n;
+  return 0;
+}
+
+uint64
+sys_history(void)
+{
+  int n;
+  uint64 addr;
+  argint(0, &n);
+  argaddr(1, &addr);
+
+  if (n <= 0 || n >= NUM_SYSCALLS)
+    return -1;
+
+  acquire(&stat_locks[n]);
+  struct syscall_stat st = syscall_stats[n];
+  release(&stat_locks[n]);
+
+  struct proc *p = myproc();
+  if (copyout(p->pagetable, addr, (char *)&st, sizeof(st)) < 0)
+    return -1;
+
+  return 0;
+}
